{
  "name": "hero-x",
  "version": "0.6.2",
  "private": true,
  "description": "HERO X - 모험의 던전 (3D 액션 RPG, Three.js + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
