      ".read": "auth != null",
      "custom": {
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['id','category','start','end','title'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "category": {
            ".validate": "newData.val() === 'install' || newData.val() === 'relocation' || newData.val() === 'evaluation' || newData.val() === 'holiday'"
          },
          "start": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "end": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "team": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
